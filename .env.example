# ── secrets ──────────────────────────────────────────────────────────────────
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

# ── app behaviour ─────────────────────────────────────────────────────────────
DJANGO_DEBUG=false

# Comma-separated hostnames/IPs that Django will serve — add your domain here
ALLOWED_HOSTS=localhost,127.0.0.1,

# HTTPS origins for CSRF (required when behind TLS reverse proxy).
# If omitted in production, https:// origins are auto-derived from ALLOWED_HOSTS.
# CSRF_TRUSTED_ORIGINS=https://example.com

# ── model weights ─────────────────────────────────────────────────────────────
# DINOv3 is a gated model. Accept the licence once on
# https://huggingface.co/facebook/dinov3-vitb16-pretrain-lvd1689m with your
# Hugging Face account, create a read token under Settings → Access Tokens,
# and put it here. The download is cached in the hf-cache volume.
HF_TOKEN=hf_change-me

# ── paths (container-internal — change only if you remap the volume) ──────────
DATA_DIR=/data
CONFIG_PATH=/data/config.toml

# ── vision / dedup / NSFW (optional tuning) ───────────────────────────────────
# PHASH_MAX_DISTANCE=5
# DINO_DEDUP_COSINE_THRESHOLD=0.92
# NSFW_THRESHOLD=0.30
